{
    email avirut@kroac.net
	acme_dns cloudflare {env.CF_API_TOKEN}

    dynamic_dns {
		provider cloudflare {env.CF_API_TOKEN} 
		domains {
			kroac.net *
                        quizzies.io *
                        embral.app *
		}
	}
}

(embral_backend) {
	# Both conditions matter. The range check alone would also match traffic
	# that merely egresses from Cloudflare (a Worker, say) straight at the
	# origin IP without CF-Connecting-IP; the header_up below would then
	# rewrite X-Forwarded-For to the empty string and the app would see no
	# client address at all, collapsing every such request into one
	# rate-limit bucket. Requiring the header sends those down the default
	# branch instead, where Caddy sets X-Forwarded-For to the peer address.
	@cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		header CF-Connecting-IP *
	}
	handle @cloudflare {
		reverse_proxy embral:8080 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy embral:8080
	}
}

embral.app {
	import embral_backend
}

cloud.embral.app {
	import embral_backend
}

kroac.net, www.kroac.net {
	reverse_proxy static-file-server:8080
}

auth.kroac.net {
	reverse_proxy authentik:9000
}

(authentik) {
	reverse_proxy /outpost.goauthentik.io/* http://authentik:9000 {
		header_up Host {http.reverse_proxy.upstream.hostport}
	}

    forward_auth {args[0]} http://authentik:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
        trusted_proxies private_ranges
    }
}

