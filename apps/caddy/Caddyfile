arr.kroac.net {
    import authentik *
    handle /qbt* {
        redir /qbt /qbt/
        handle_path /qbt/* {
            reverse_proxy gluetun:8080 {
                header_up Host gluetun:8080
                header_up -Origin
                header_up -Referer
            }
        }
    }
    handle /autobrr* {
        redir /autobrr /autobrr/
        uri strip_prefix /autobrr
        reverse_proxy autobrr:7474
    }
    reverse_proxy /sabnzbd* gluetun:15544
    reverse_proxy /sonarr* sonarr:8989
    reverse_proxy /radarr* radarr:7878
    reverse_proxy /prowlarr* prowlarr:9696
    reverse_proxy /bazarr* bazarr:6767
    reverse_proxy /readarr* readarr:8787
    reverse_proxy homarr:7575
}

